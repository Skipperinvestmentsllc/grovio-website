{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/blog",
      "destination": "/guide/",
      "permanent": true
    },
    {
      "source": "/partner-admin/marketing",
      "destination": "/admin/marketing",
      "permanent": true
    },
    {
      "source": "/partner-admin",
      "destination": "/admin/influencers",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/guide", "destination": "/guide/index.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/support", "destination": "/support.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/delete-account", "destination": "/delete-account.html" },
    { "source": "/compare", "destination": "/compare.html" },
    { "source": "/features", "destination": "/features.html" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/podcast", "destination": "/podcast.html" },
    { "source": "/podcast/:slug", "destination": "/podcast/:slug.html" },
    { "source": "/get", "destination": "/get.html" },
    { "source": "/start", "destination": "/start.html" },
    { "source": "/community", "destination": "/community.html" },
    { "source": "/creator-program", "destination": "/creator-program.html" },
    { "source": "/links", "destination": "/links/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/share/:token", "destination": "/share" },
    { "source": "/p/:slug", "destination": "/p/:slug.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" },
        { "key": "Vercel-CDN-Cache-Control", "value": "max-age=604800, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" },
        { "key": "Vercel-CDN-Cache-Control", "value": "max-age=604800, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=120, stale-while-revalidate=600" },
        { "key": "Vercel-CDN-Cache-Control", "value": "max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(features|pricing|podcast|guide|compare|about|faq|support|privacy|terms|creator-program|start|links)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=120, stale-while-revalidate=600" },
        { "key": "Vercel-CDN-Cache-Control", "value": "max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(podcast|guide|about)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=120, stale-while-revalidate=600" },
        { "key": "Vercel-CDN-Cache-Control", "value": "max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/start",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/creator-program",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/p/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ]
}
